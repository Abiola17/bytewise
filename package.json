{
  "name": "bytewise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bytewise/server --filter @bytewise/web dev",
    "dev:server": "pnpm --filter @bytewise/server dev",
    "dev:web": "pnpm --filter @bytewise/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @bytewise/server db:generate",
    "test:e2e": "playwright test",
    "ext:build": "pnpm --filter bytewise build",
    "ext:test": "pnpm --filter bytewise test && pnpm --filter bytewise test:vscode",
    "ext:package": "pnpm --filter bytewise package"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
